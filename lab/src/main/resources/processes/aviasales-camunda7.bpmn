<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.23.0">
  <bpmn:message id="Message_PaymentReceived" name="PaymentReceived" />
  <bpmn:message id="Message_CrmDealCreated" name="CrmDealCreated" />
  <bpmn:process id="Process_Main" name="Покупка авиабилета" processType="None" isClosed="false" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:extensionElements>
      <camunda:executionListener delegateExpression="${initializePurchaseListener}" event="start" />
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_Main">
      <bpmn:lane id="Lane_User" name="Пользователь / ROLE_USER">
        <bpmn:flowNodeRef>StartEvent_User</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_0qct9sk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_1djsotr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_1wkigj3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_10hakir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_User_Select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_User_Payment_Redirect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_User_Search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_0o8m1af</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_User_Flight_Select</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Backend" name="Backend / системная логика">
        <bpmn:flowNodeRef>Event_0io0e9o</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Save_Ticket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Send_Email</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_0xnwoyp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Req_Booking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Show_Results</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Create_Order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_01uhvfb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_126lgmh</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_132now7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_072zhh0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_0dt0z2r</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Redirect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_14ueg7e</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_00mcqel</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_User">
      <bpmn:outgoing>Flow_U1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="Event_0io0e9o" name="Ожидание подтверждения оплаты">
      <bpmn:incoming>Flow_Payment_Redirect_To_Event</bpmn:incoming>
      <bpmn:outgoing>Flow_1y5bw71</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1kdxzyq" messageRef="Message_PaymentReceived" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="Event_0qct9sk">
      <bpmn:incoming>Msg_Email</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_Type" name="Тип покупки?" default="Flow_19uwbnq">
      <bpmn:incoming>Msg_Select</bpmn:incoming>
      <bpmn:outgoing>Flow_Go_Redirect</bpmn:outgoing>
      <bpmn:outgoing>Flow_19uwbnq</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Redirect" name="Генерация ссылки редиректа" camunda:delegateExpression="${redirectDelegate}">
      <bpmn:incoming>Flow_Go_Redirect</bpmn:incoming>
      <bpmn:outgoing>Flow_14zagb9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Save_Ticket" name="Сохранить билет в БД" camunda:delegateExpression="${saveTicketDelegate}">
      <bpmn:incoming>Flow_0z56wef</bpmn:incoming>
      <bpmn:incoming>Flow_0lqvfay</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Send_Email" name="Отправить PDF клиенту" camunda:delegateExpression="${emailDelegate}">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Msg_Email</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="Event_0xnwoyp" name="seat is already taken">
      <bpmn:incoming>Flow_1wytfm9</bpmn:incoming>
      <bpmn:linkEventDefinition id="LinkEventDefinition_0mf0erc" name="SeatUnavailable" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Event_1djsotr" name="seat are already taken">
      <bpmn:outgoing>Flow_16092zt</bpmn:outgoing>
      <bpmn:linkEventDefinition id="LinkEventDefinition_0ru80fq" name="SeatUnavailable" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_Create_Order" name="Создать заказ" camunda:delegateExpression="${createOrderDelegate}">
      <bpmn:incoming>Flow_19uwbnq</bpmn:incoming>
      <bpmn:outgoing>Flow_1udm2te</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Event_1wkigj3" name="payment failure">
      <bpmn:outgoing>Flow_0493ee5</bpmn:outgoing>
      <bpmn:linkEventDefinition id="LinkEventDefinition_1cn7v7j" name="PaymentFailure" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_10hakir">
      <bpmn:incoming>Flow_16092zt</bpmn:incoming>
      <bpmn:incoming>Flow_0493ee5</bpmn:incoming>
      <bpmn:outgoing>Flow_1v9k2nj</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_01uhvfb" name="Обработка оплаты" camunda:delegateExpression="${processPaymentDelegate}">
      <bpmn:incoming>Flow_1y5bw71</bpmn:incoming>
      <bpmn:outgoing>Flow_19n80lj</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_User_Search" name="Ввод параметров поиска">
      <bpmn:extensionElements>
        <camunda:taskListener delegateExpression="${assignProcessOwnerTaskListener}" event="create" />
        <camunda:taskListener delegateExpression="${validatePurchaseFormListener}" event="complete" />
        <camunda:formData>
          <camunda:formField id="flightId" label="ID выбранного рейса" type="long" />
          <camunda:formField id="from" label="Аэропорт отправления" type="string" />
          <camunda:formField id="to" label="Аэропорт прибытия" type="string" />
          <camunda:formField id="date" label="Дата рейса" type="string" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_U1</bpmn:incoming>
      <bpmn:incoming>Flow_1v9k2nj</bpmn:incoming>
      <bpmn:incoming>Flow_05nnsn8</bpmn:incoming>
      <bpmn:outgoing>Flow_06spb9e</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_User_Flight_Select" name="Проверить наличие и выбрать рейс" camunda:formKey="embedded:app:flight-selection.html">
      <bpmn:extensionElements>
        <camunda:taskListener delegateExpression="${assignProcessOwnerTaskListener}" event="create" />
        <camunda:formData>
          <camunda:formField id="availableFlightsSummary" label="Найденные рейсы" type="string" />
          <camunda:formField id="hasSuitableFlight" label="Подходящий билет найден?" type="enum">
            <camunda:value id="true" name="Да" />
            <camunda:value id="false" name="Нет подходящего билета" />
          </camunda:formField>
          <camunda:formField id="flightId" label="Рейс" type="enum" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Msg_Show</bpmn:incoming>
      <bpmn:outgoing>Flow_Flight_Select_To_Purchase</bpmn:outgoing>
      <bpmn:outgoing>Flow_05nnsn8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_User_Select" name="Заполнить данные покупки">
      <bpmn:extensionElements>
        <camunda:taskListener delegateExpression="${assignProcessOwnerTaskListener}" event="create" />
        <camunda:taskListener delegateExpression="${validatePurchaseFormListener}" event="complete" />
        <camunda:formData>
          <camunda:formField id="method" label="Способ покупки" type="enum" defaultValue="internal">
            <camunda:value id="internal" name="Покупка в системе" />
            <camunda:value id="redirect" name="Редирект к авиакомпании" />
          </camunda:formField>
          <camunda:formField id="availableFlightsSummary" label="Найденные рейсы" type="string">
            <camunda:validation>
              <camunda:constraint name="readonly" />
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="flightId" label="ID рейса" type="long" />
          <camunda:formField id="currency" label="Валюта" type="string" defaultValue="RUB" />
          <camunda:formField id="seatNumber" label="Место" type="string" />
          <camunda:formField id="seatClass" label="Класс места" type="enum" defaultValue="ECONOMY">
            <camunda:value id="ECONOMY" name="ECONOMY" />
            <camunda:value id="BUSINESS" name="BUSINESS" />
          </camunda:formField>
          <camunda:formField id="hasBaggage" label="Багаж" type="boolean" />
          <camunda:formField id="passengerName" label="ФИО пассажира" type="string" />
          <camunda:formField id="passengerPassport" label="Паспорт пассажира" type="string" />
          <camunda:formField id="provider" label="Платёжный провайдер" type="string" defaultValue="internal-bank" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Flight_Select_To_Purchase</bpmn:incoming>
      <bpmn:outgoing>Msg_Select</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_User_Payment_Redirect" name="Получить ссылку оплаты">
      <bpmn:extensionElements>
        <camunda:taskListener delegateExpression="${assignProcessOwnerTaskListener}" event="create" />
        <camunda:formData>
          <camunda:formField id="redirectUrl" label="Ссылка для оплаты" type="string">
            <camunda:validation>
              <camunda:constraint name="readonly" />
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="paymentInstruction" label="После оплаты нажмите Complete" type="string" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1udm2te</bpmn:incoming>
      <bpmn:outgoing>Flow_Payment_Redirect_To_Event</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Req_Booking" name="Запрос эмиссии в АК" camunda:delegateExpression="${bookingDelegate}">
      <bpmn:incoming>Flow_19n80lj</bpmn:incoming>
      <bpmn:outgoing>Flow_0ebh3k3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_126lgmh" name="Отправка билета в LAXO" camunda:delegateExpression="${exportCrmDelegate}">
      <bpmn:incoming>Flow_0ebh3k3</bpmn:incoming>
      <bpmn:outgoing>Flow_0z56wef</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Event_132now7" attachedToRef="Task_Create_Order">
      <bpmn:outgoing>Flow_1wytfm9</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_0nruic8" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_U1" sourceRef="StartEvent_User" targetRef="Task_User_Search" />
    <bpmn:sequenceFlow id="Msg_Show" sourceRef="Task_Show_Results" targetRef="Task_User_Flight_Select" />
    <bpmn:sequenceFlow id="Flow_1udm2te" sourceRef="Task_Create_Order" targetRef="Task_User_Payment_Redirect" />
    <bpmn:sequenceFlow id="Flow_Payment_Redirect_To_Event" sourceRef="Task_User_Payment_Redirect" targetRef="Event_0io0e9o" />
    <bpmn:sequenceFlow id="Flow_1y5bw71" sourceRef="Event_0io0e9o" targetRef="Activity_01uhvfb" />
    <bpmn:sequenceFlow id="Msg_Email" sourceRef="Task_Send_Email" targetRef="Event_0qct9sk" />
    <bpmn:sequenceFlow id="Msg_Select" sourceRef="Task_User_Select" targetRef="Gateway_Type" />
    <bpmn:sequenceFlow id="Flow_Go_Redirect" name="На сайте АК" sourceRef="Gateway_Type" targetRef="Task_Redirect">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${method == 'redirect'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_19uwbnq" name="У нас" sourceRef="Gateway_Type" targetRef="Task_Create_Order" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Save_Ticket" targetRef="Task_Send_Email" />
    <bpmn:sequenceFlow id="Flow_1wytfm9" sourceRef="Event_132now7" targetRef="Event_0xnwoyp" />
    <bpmn:sequenceFlow id="Flow_16092zt" sourceRef="Event_1djsotr" targetRef="Gateway_10hakir" />
    <bpmn:sequenceFlow id="Flow_0493ee5" sourceRef="Event_1wkigj3" targetRef="Gateway_10hakir" />
    <bpmn:sequenceFlow id="Flow_1v9k2nj" sourceRef="Gateway_10hakir" targetRef="Task_User_Search" />
    <bpmn:sequenceFlow id="Flow_06spb9e" sourceRef="Task_User_Search" targetRef="Task_Show_Results" />
    <bpmn:sequenceFlow id="Flow_Flight_Select_To_Purchase" name="hasSuitableFlight == true" sourceRef="Task_User_Flight_Select" targetRef="Task_User_Select">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hasSuitableFlight == 'true'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0ebh3k3" sourceRef="Task_Req_Booking" targetRef="Activity_126lgmh" />
    <bpmn:boundaryEvent id="Event_072zhh0" attachedToRef="Activity_01uhvfb">
      <bpmn:outgoing>Flow_15bvciz</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_01ycp32" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_Show_Results" name="Вернуть список рейсов" camunda:delegateExpression="${showFlightsDelegate}">
      <bpmn:incoming>Flow_06spb9e</bpmn:incoming>
      <bpmn:outgoing>Msg_Show</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="Event_0dt0z2r" name="payment failure">
      <bpmn:incoming>Flow_15bvciz</bpmn:incoming>
      <bpmn:linkEventDefinition id="LinkEventDefinition_1ma6cv0" name="PaymentFailure" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="Flow_15bvciz" sourceRef="Event_072zhh0" targetRef="Event_0dt0z2r" />
    <bpmn:sequenceFlow id="Flow_0z56wef" sourceRef="Activity_126lgmh" targetRef="Task_Save_Ticket" />
    <bpmn:userTask id="Activity_0o8m1af" name="Получить ссылку на сайт АК">
      <bpmn:incoming>Flow_14zagb9</bpmn:incoming>
      <bpmn:outgoing>Flow_07t9vaq</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_14zagb9" sourceRef="Task_Redirect" targetRef="Activity_0o8m1af" />
    <bpmn:intermediateCatchEvent id="Event_14ueg7e" name="Ожидание завершение АК">
      <bpmn:incoming>Flow_07t9vaq</bpmn:incoming>
      <bpmn:outgoing>Flow_0z0bm7a</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_030ywqz" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_07t9vaq" sourceRef="Activity_0o8m1af" targetRef="Event_14ueg7e" />
    <bpmn:sequenceFlow id="Flow_0z0bm7a" sourceRef="Event_14ueg7e" targetRef="Activity_00mcqel" />
    <bpmn:sequenceFlow id="Flow_0lqvfay" sourceRef="Activity_00mcqel" targetRef="Task_Save_Ticket" />
    <bpmn:serviceTask id="Activity_00mcqel" name="Создать заказ">
      <bpmn:incoming>Flow_0z0bm7a</bpmn:incoming>
      <bpmn:outgoing>Flow_0lqvfay</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_19n80lj" sourceRef="Activity_01uhvfb" targetRef="Task_Req_Booking" />
    <bpmn:sequenceFlow id="Flow_05nnsn8" name="hasSuitableFlight == false" sourceRef="Task_User_Flight_Select" targetRef="Task_User_Search">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hasSuitableFlight == 'false'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_Main">
      <bpmndi:BPMNShape id="Lane_Backend_di" bpmnElement="Lane_Backend" isHorizontal="true" bioc:stroke="#205022" bioc:fill="#c8e6c9" color:background-color="#c8e6c9" color:border-color="#205022">
